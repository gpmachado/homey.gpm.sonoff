{
  "id": "S60ZBTPF",
  "name": {
    "en": "Wall Plug S60ZBTPF",
    "es": "Enchufe S60ZBTPF",
    "it": "Presa S60ZBTPF",
    "de": "Steckdose S60ZBTPF"
  },
  "class": "socket",
  "capabilities": [
    "onoff",
    "measure_power",
    "measure_current",
    "measure_voltage",
    "meter_power",
    "meter_power.today",
    "meter_power.yesterday",
    "meter_power.month"
  ],
  "capabilitiesOptions": {
    "meter_power.today": { "title": { "en": "Energy today" } },
    "meter_power.yesterday": { "title": { "en": "Energy yesterday" } },
    "meter_power.month": { "title": { "en": "Energy this month" } }
  },
  "icon": "{{driverAssetsPath}}/icon.svg",
  "zigbee": {
    "manufacturerName": ["SONOFF"],
    "productId": ["S60ZBTPF", "S60ZBTPG"],
    "endpoints": {
      "1": { "clusters": [0, 3, 4, 5, 6, 1794, 2820, 64599, 64529], "bindings": [6, 2820] }
    },
    "learnmode": {
      "image": "{{driverAssetsPath}}/learn.svg",
      "instruction": {
        "en": "Press and hold the button for 5 seconds until the LED flashes.",
        "es": "Mantén pulsado el botón durante 5 segundos hasta que el LED parpadee.",
        "it": "Tieni premuto il pulsante per 5 secondi fino a quando il LED lampeggia.",
        "de": "Halte die Taste 5 Sekunden gedrückt, bis die LED blinkt."
      }
    }
  },
  "settings": [
    {
      "id": "network_indicator",
      "type": "checkbox",
      "label": { "en": "Network indicator LED" },
      "value": true,
      "hint": { "en": "Turn the blue network status LED on or off." }
    },
    {
      "id": "outlet_control_protect",
      "type": "checkbox",
      "label": { "en": "Lock remote control" },
      "value": false,
      "hint": { "en": "When enabled, the outlet ignores on/off commands from Homey and the physical button - use to prevent accidental control." }
    },
    {
      "id": "power_on_behavior",
      "type": "dropdown",
      "label": { "en": "Power-on behavior" },
      "value": "last_state",
      "values": [
        { "id": "off", "label": { "en": "Off" } },
        { "id": "on", "label": { "en": "On" } },
        { "id": "toggle", "label": { "en": "Toggle" } },
        { "id": "last_state", "label": { "en": "Last state" } }
      ]
    },
    {
      "type": "group",
      "label": { "en": "Inching" },
      "children": [
        {
          "id": "inching_control",
          "type": "checkbox",
          "label": { "en": "Enable" },
          "hint": { "en": "Automatically turn off/on after a specified time" },
          "value": false
        },
        {
          "id": "inching_mode",
          "type": "dropdown",
          "label": { "en": "Action" },
          "hint": { "en": "Turn off after turning on, or turn on after turning off" },
          "value": "off",
          "values": [
            { "id": "off", "label": { "en": "Turn off after on" } },
            { "id": "on", "label": { "en": "Turn on after off" } }
          ]
        },
        {
          "id": "inching_time",
          "type": "number",
          "label": { "en": "Time (seconds)" },
          "hint": { "en": "Time before automatic action (0.5 - 3599.5 seconds)" },
          "value": 1,
          "min": 0.5,
          "max": 3599.5,
          "step": 0.5
        }
      ]
    }
  ],
  "$extends": ["zigbee-local"]
}
