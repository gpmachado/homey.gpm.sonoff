{
  "id": "MINI-ZB1GSP",
  "name": {
    "en": "Sonoff Switch ZB1GSP (with power monitoring)",
    "es": "Interruptor Sonoff ZB1GSP (con medición de energía)",
    "it": "Interruttore Sonoff ZB1GSP (con misurazione di potenza)",
    "de": "Sonoff Schalter ZB1GSP (mit Leistungsmessung)"
  },
  "class": "socket",
  "capabilities": [
    "onoff",
    "is_availability",
    "measure_power",
    "measure_voltage",
    "measure_current",
    "meter_power",
    "meter_power.today",
    "meter_power.month",
    "meter_power.exported",
    "output_energy_today",
    "output_energy_month",
    "alarm_generic",
    "alarm_generic.metering_error",
    "alarm_generic.overload_protection"
  ],
  "capabilitiesOptions": {
    "meter_power.today": { "title": { "en": "Energy today" } },
    "meter_power.month": { "title": { "en": "Energy this month" } },
    "meter_power.exported": { "title": { "en": "Exported" } },
    "alarm_generic": { "title": { "en": "Overheated" } },
    "alarm_generic.metering_error": { "title": { "en": "Metering error" } },
    "alarm_generic.overload_protection": { "title": { "en": "Overload protection" } }
  },
  "energy": {
    "meterPowerImportedCapability": "meter_power",
    "meterPowerExportedCapability": "meter_power.exported"
  },
  "icon": "{{driverAssetsPath}}/icon.svg",
  "zigbee": {
    "manufacturerName": ["SONOFF"],
    "productId": ["MINI-ZB1GSP"],
    "endpoints": {
      "1": { "clusters": [0, 6, 64529], "bindings": [6] }
    },
    "learnmode": {
      "image": "{{driverAssetsPath}}/learn.svg",
      "instruction": {
        "en": "Press the button on the top for approx 10 seconds until the green LED blinks rapidly.",
        "es": "Pulsa el botón de la parte superior durante aprox. 10 segundos hasta que el LED verde parpadee rápidamente.",
        "it": "Premi il pulsante nella parte superiore per circa 10 secondi fino a quando il LED verde lampeggia rapidamente.",
        "de": "Drücke die Taste oben ca. 10 Sekunden, bis die grüne LED schnell blinkt."
      }
    }
  },
  "settings": [
    {
      "id": "network_indicator",
      "type": "checkbox",
      "label": { "en": "Network indicator LED" },
      "value": true,
      "hint": { "en": "Turn the blue network status LED on or off." }
    },
    {
      "id": "turbo_mode",
      "type": "checkbox",
      "label": { "en": "Turbo mode" },
      "value": false,
      "hint": { "en": "Boosts Zigbee radio transmit power to improve range." }
    },
    {
      "id": "switch_mode",
      "type": "dropdown",
      "label": { "en": "Switch mode" },
      "value": "0",
      "hint": { "en": "Type of external switch wired to the device. Use 'Pulse' for self-resetting (momentary) buttons. 'Edge' is the default for a normal rocker." },
      "values": [
        { "id": "0", "label": { "en": "Edge (rocker)" } },
        { "id": "1", "label": { "en": "Pulse (momentary)" } },
        { "id": "2", "label": { "en": "Follow switch" } },
        { "id": "130", "label": { "en": "Follow switch (inverted)" } }
      ]
    },
    {
      "id": "power_on_behavior",
      "type": "dropdown",
      "label": { "en": "Power-on behavior" },
      "value": "off",
      "values": [
        { "id": "off", "label": { "en": "Off" } },
        { "id": "on", "label": { "en": "On" } },
        { "id": "last_state", "label": { "en": "Last state" } }
      ]
    },
    {
      "type": "group",
      "label": { "en": "Delayed power-on" },
      "children": [
        {
          "id": "delayed_power_on_state",
          "type": "checkbox",
          "label": { "en": "Enable" },
          "hint": { "en": "Turn the device on automatically after the delay below, once powered." },
          "value": false
        },
        {
          "id": "delayed_power_on_time",
          "type": "number",
          "label": { "en": "Delay (seconds)" },
          "hint": { "en": "Time to wait before the delayed power-on action (0.5 - 3599.5 seconds)." },
          "value": 1,
          "min": 0.5,
          "max": 3599.5,
          "step": 0.5
        }
      ]
    },
    {
      "id": "detach_relay",
      "type": "checkbox",
      "label": { "en": "Detach relay (experimental)" },
      "value": false,
      "hint": { "en": "Experimental: the device may reject this write with MALFORMED_COMMAND. Kept as a setting so it lights up automatically once supported. When working: the physical rocker stops switching the relay — useful for controlling a smart bulb via scene instead." }
    },
    {
      "type": "group",
      "label": { "en": "Inching" },
      "children": [
        {
          "id": "inching_control",
          "type": "checkbox",
          "label": { "en": "Enable" },
          "hint": { "en": "Automatically turn off/on after a specified time" },
          "value": false
        },
        {
          "id": "inching_mode",
          "type": "dropdown",
          "label": { "en": "Action" },
          "hint": { "en": "Turn off after turning on, or turn on after turning off" },
          "value": "off",
          "values": [
            { "id": "off", "label": { "en": "Turn off after on" } },
            { "id": "on", "label": { "en": "Turn on after off" } }
          ]
        },
        {
          "id": "inching_time",
          "type": "number",
          "label": { "en": "Time (seconds)" },
          "hint": { "en": "Time before automatic action (0.5 - 3599.5 seconds)" },
          "value": 1,
          "min": 0.5,
          "max": 3599.5,
          "step": 0.5
        }
      ]
    },
    {
      "type": "group",
      "label": { "en": "Power protector" },
      "children": [
        {
          "id": "max_current_protect",
          "type": "number",
          "label": { "en": "Max current (A)" },
          "value": 16,
          "min": 0.1,
          "max": 16,
          "step": 0.1
        },
        {
          "id": "max_power_protect",
          "type": "number",
          "label": { "en": "Max power (W)" },
          "value": 3840,
          "min": 2,
          "max": 3840,
          "step": 0.1
        },
        {
          "id": "max_voltage_protect_enabled",
          "type": "checkbox",
          "label": { "en": "Enable overvoltage protection" },
          "value": false
        },
        {
          "id": "max_voltage_protect",
          "type": "number",
          "label": { "en": "Max voltage (V)" },
          "value": 277,
          "min": 85,
          "max": 277,
          "step": 1
        },
        {
          "id": "min_voltage_protect_enabled",
          "type": "checkbox",
          "label": { "en": "Enable undervoltage protection" },
          "value": false
        },
        {
          "id": "min_voltage_protect",
          "type": "number",
          "label": { "en": "Min voltage (V)" },
          "value": 85,
          "min": 85,
          "max": 277,
          "step": 1
        },
        {
          "id": "external_switch_only_recovery",
          "type": "checkbox",
          "label": { "en": "Recover only via external switch" },
          "value": false
        },
        {
          "id": "auto_recovery",
          "type": "checkbox",
          "label": { "en": "Auto-recover when back in range" },
          "value": false
        }
      ]
    }
  ],
  "$extends": ["zigbee-local"]
}
